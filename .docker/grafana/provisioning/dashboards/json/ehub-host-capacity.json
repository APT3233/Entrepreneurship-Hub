{
  "uid": "ehub-host-capacity",
  "title": "EHub Host Capacity",
  "tags": ["ehub", "host", "node-exporter"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU Busy",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "ehub:host_cpu_busy_percent", "legendFormat": "{{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Load Average",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"refId": "A", "expr": "node_load1", "legendFormat": "load1"},
        {"refId": "B", "expr": "node_load5", "legendFormat": "load5"},
        {"refId": "C", "expr": "node_load15", "legendFormat": "load15"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memory Used",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"refId": "A", "expr": "ehub:host_memory_used_percent", "legendFormat": "used"}],
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Filesystem Used",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"refId": "A", "expr": "ehub:host_filesystem_used_percent{mountpoint!~\"/run.*|/boot/efi\"}", "legendFormat": "{{mountpoint}}"}],
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Disk Throughput",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {"refId": "A", "expr": "sum by (device) (rate(node_disk_read_bytes_total[5m]))", "legendFormat": "{{device}} read"},
        {"refId": "B", "expr": "sum by (device) (rate(node_disk_written_bytes_total[5m]))", "legendFormat": "{{device}} write"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Network Throughput",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {"refId": "A", "expr": "sum by (device) (rate(node_network_receive_bytes_total{device!~\"lo|veth.*|br-.*|docker.*\"}[5m]))", "legendFormat": "{{device}} rx"},
        {"refId": "B", "expr": "sum by (device) (rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|br-.*|docker.*\"}[5m]))", "legendFormat": "{{device}} tx"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}
    }
  ]
}
