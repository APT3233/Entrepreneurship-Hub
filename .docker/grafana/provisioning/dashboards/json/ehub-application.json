{
  "uid": "ehub-application",
  "title": "EHub Application API",
  "tags": ["ehub", "application", "api", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API Requests In 5m",
      "datasource": {"type": "loki", "uid": "Loki"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(count_over_time({compose_service=\"nginx\"} | json | request=~\".* /api/.*\" [5m]))", "queryType": "range"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto"}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "API 4xx In 5m",
      "datasource": {"type": "loki", "uid": "Loki"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(count_over_time({compose_service=\"nginx\"} | json | request=~\".* /api/.*\" | status >= 400 | status < 500 [5m]))", "queryType": "range"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5}, {"color": "red", "value": 20}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto"}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "API 5xx In 5m",
      "datasource": {"type": "loki", "uid": "Loki"},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(count_over_time({compose_service=\"nginx\"} | json | request=~\".* /api/.*\" | status >= 500 [5m]))", "queryType": "range"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto"}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "App Error Logs In 5m",
      "datasource": {"type": "loki", "uid": "Loki"},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(count_over_time({compose_service=\"ehub-server\"} |~ \"(?i)error|fatal|exception|failed\" [5m]))", "queryType": "range"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto"}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API Status Count",
      "datasource": {"type": "loki", "uid": "Loki"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [{"refId": "A", "expr": "sum by (status) (count_over_time({compose_service=\"nginx\"} | json | request=~\".* /api/.*\" [5m]))", "queryType": "range", "legendFormat": "{{status}}"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "API Latency p95",
      "datasource": {"type": "loki", "uid": "Loki"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [{"refId": "A", "expr": "quantile_over_time(0.95, {compose_service=\"nginx\"} | json | request=~\".* /api/.*\" | unwrap request_time [5m])", "queryType": "range", "legendFormat": "p95"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Application Logs",
      "datasource": {"type": "loki", "uid": "Loki"},
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 12},
      "targets": [{"refId": "A", "expr": "{compose_service=\"ehub-server\"}", "queryType": "range"}],
      "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "dedupStrategy": "none", "enableLogDetails": true}
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Application Errors",
      "datasource": {"type": "loki", "uid": "Loki"},
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 12},
      "targets": [{"refId": "A", "expr": "{compose_service=\"ehub-server\"} |~ \"(?i)error|fatal|exception|failed|unauthorized|forbidden\"", "queryType": "range"}],
      "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "dedupStrategy": "none", "enableLogDetails": true}
    }
  ]
}
