{
  "name": "ehub-backend",
  "version": "1.0.0",
  "description": "E-HUB is a strategic project by the Entrepreneurship Department to build a centralized digital system for managing and utilizing entrepreneurship activity data at FPT University.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "npm run dev:linux",
    "start": "node server.js",
    "dev:win": "Get-Content .env.win | % { if ($_ -match '^(.*?)=(.*)$') { set-item env:$($matches[1]) $matches[2] } }; nodemon server.js",
    "dev:linux": "[ -f ./.env.linux ] && . ./.env.linux; nodemon server.js",
    "worker:mail:linux": "[ -f ./.env.linux ] && . ./.env.linux; node app/workers/mailOutbox.entry.js",
    "worker:ai:linux": "[ -f ./.env.linux ] && . ./.env.linux; node app/workers/aiEvaluation.entry.js",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "awilix": "^13.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.78.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.3",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "minio": "^8.0.7",
    "multer": "^2.1.1",
    "mysql2": "^3.18.0",
    "nodemailer": "^6.10.1",
    "officeparser": "^7.1.0",
    "p-limit": "^6.2.0",
    "pdf-parse": "^2.2.4",
    "uuid": "^13.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "app"
  ]
}
