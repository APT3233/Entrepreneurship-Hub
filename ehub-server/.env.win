# ── Redis
REDIS_PORT=6379

# ── App
NODE_ENV=development
HOST=localhost
APP_PORT=7777
CLIENT_PORT=5173

# CORS_ORIGINS=http://localhost:5173,https://ehub.apt3233.id.vn
CORS_ORIGINS=http://localhost:5173

# Khi chạy qua Cloudflare/tunnel: set domain cookie để F5 vẫn gửi refresh_token (xóa hoặc comment khi chỉ chạy localhost)
# COOKIE_DOMAIN=ehub.apt3233.id.vn
COOKIE_DOMAIN=localhost

# ── JWT Auth
JWT_SECRET=super_secret_access_key_development_only
JWT_REFRESH_SECRET=super_secret_refresh_key_development_only
JWT_EXPIRES_IN=1h
JWT_REFRESH_IN=30d
JWT_ISSUER=ehub-server

# ── AI Evaluation Assistant
CMD_API_KEY=
AI_BASE_URL=http://localhost:20128/v1
AI_CHAT_COMPLETIONS_PATH=/chat/completions
AI_MODEL=cmc/MiniMaxAI/MiniMax-M2.5
AI_ENABLED=true
AI_STREAM=true
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=120000
AI_DEBUG_PROMPT_MAX_CHARS=12000
AI_SECRET_ENCRYPTION_KEY=
# Global AI
AI_ACTIVE_PROVIDER=local-gemma
AI_WORKER_ENABLED=true
AI_WORKER_POLL_MS=3000
AI_WORKER_MAX_ATTEMPTS=3
AI_WORKER_STALE_PROCESSING_MINUTES=15
AI_MAX_CONCURRENT_JOBS=1
AI_ANALYZE_COOLDOWN_SECONDS=60

# CMD API Provider
CMD_AI_BASE_URL=http://localhost:20128/v1
CMD_AI_MODEL=cmc/MiniMaxAI/MiniMax-M2.5
CMD_AI_STREAM=true

# Local Gemma Provider
LOCAL_GEMMA_BASE_URL=http://ollama:11434/v1
LOCAL_GEMMA_HOST_BASE_URL=http://localhost:11434/v1
LOCAL_GEMMA_MODEL=qwen2.5:7b
LOCAL_GEMMA_STREAM=true
LOCAL_GEMMA_API_KEY=
LOCAL_GEMMA_API_KEY_REQUIRED=false
